{
  "name": "pickup-soccer-server",
  "version": "0.1.0",
  "private": true,
  "description": "NYC Pickup Soccer System - Express API (CS-GY 6083 Part 3)",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "test:db": "SHIFT_DATES=0 PGDATABASE=nyc_fields_test ../db/reset.sh && psql -q -v ON_ERROR_STOP=1 -d nyc_fields_test -f test/fake-clock.sql",
    "test": "npm run test:db && DATABASE_URL=postgres://localhost/nyc_fields_test node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "test:coverage": "npm run test:db && DATABASE_URL=postgres://localhost/nyc_fields_test node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 \"test/**/*.test.js\""
  },
  "dependencies": {
    "connect-pg-simple": "^10.0.0",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "pg": "^8.23.1"
  }
}
