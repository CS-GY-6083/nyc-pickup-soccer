{
  "name": "pickup-soccer-server",
  "version": "0.1.0",
  "private": true,
  "description": "NYC Pickup Soccer System - Express API (CS-GY 6083 Part 3)",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "test:db": "node --env-file-if-exists=.env test/run.mjs --db-only",
    "test": "node --env-file-if-exists=.env test/run.mjs",
    "test:coverage": "node --env-file-if-exists=.env test/run.mjs --coverage"
  },
  "dependencies": {
    "connect-pg-simple": "^10.0.0",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "pg": "^8.23.1"
  }
}
